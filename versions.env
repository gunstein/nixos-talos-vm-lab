# versions.env - Pinned versions for the Talos lab
#
# This file documents all component versions used in the lab.
# Update these when upgrading components.
#
# Note: Most versions are pinned directly in YAML manifests for simplicity.
# This file serves as a central reference for what's deployed.

# =============================================================================
# Core Infrastructure
# =============================================================================

# Talos Linux - download from https://github.com/siderolabs/talos/releases
TALOS_VERSION=v1.9.0

# =============================================================================
# Kubernetes Add-ons (pinned in k8s/addons/*.yaml)
# =============================================================================

# Ingress
TRAEFIK_VERSION=v3.2

# Monitoring
PROMETHEUS_VERSION=v2.48.0
GRAFANA_VERSION=10.2.0
LOKI_VERSION=3.0.0
PROMTAIL_VERSION=3.0.0

# Storage
LOCAL_PATH_PROVISIONER_VERSION=v0.0.30

# Metrics
METRICS_SERVER_VERSION=v0.8.0

# Database
CLOUDNATIVEPG_VERSION=1.25.1

# =============================================================================
# Application Images (pinned in k8s/apps/*.yaml)
# =============================================================================

NGINX_VERSION=stable-alpine
