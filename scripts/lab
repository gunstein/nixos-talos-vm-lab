#!/usr/bin/env bash
set -euo pipefail
source "$(cd "$(dirname "$0")" && pwd)/common.sh"

# Enforce canonical deploy tree
if [[ "$ROOT" != "/etc/nixos/talos-host" ]]; then
  echo "ERROR: Run from /etc/nixos/talos-host (canonical deploy tree)." >&2
  echo "  cd /etc/nixos/talos-host" >&2
  exit 1
fi

# Pass-through wrapper: all argument parsing is done in lab.sh
# Just ensure we have at least some arguments
if [[ $# -eq 0 ]]; then
  exec "${ROOT}/scripts/lab.sh" --help
fi

as_root "$@"
exec "${ROOT}/scripts/lab.sh" "$@"
